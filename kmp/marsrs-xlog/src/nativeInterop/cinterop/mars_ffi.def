# The C ABI of mars-rs: `mars_xlog.h` of `crates/mars-ffi`, read through
# cinterop.
#
# Two lines are appended by `marsrs-xlog/build.gradle.kts`, which writes one copy
# of this file per Kotlin target into the build directory: `compilerOpts`, the
# directory the header is read out of, and `libraryPaths`, the directory the
# archive `scripts/build_kmp_native.sh` built for that target is in.
#
# `staticLibraries` is what puts the archive *into* the klib, so an app that
# depends on the module links `mars-ffi` without being told where it is.

package = io.github.orangeboychen.marsrs.xlog.ffi
headers = mars_xlog.h
# `mars_xlog.h` is the whole surface; without the filter cinterop reads the
# declarations of everything the header includes as well.
headerFilter = mars_xlog.h
staticLibraries = libmars_ffi.a

# `iana-time-zone` asks `CFTimeZone*` what the time zone is, which is why
# `Package.swift` names the framework in its `linkerSettings` too: a Rust
# `staticlib` carries no link flags of its own.
linkerOpts.osx = -framework CoreFoundation
linkerOpts.ios = -framework CoreFoundation
linkerOpts.watchos = -framework CoreFoundation
linkerOpts.tvos = -framework CoreFoundation

# What `rustc --print native-static-libs` names for a Rust `staticlib` of the
# same target: the C runtime and the unwinder behind `panic = "unwind"`, which
# is what the release profile builds with.
linkerOpts.linux = -ldl -lpthread -lm -lrt -lgcc_s
linkerOpts.mingw = -lgcc_eh -lmingwex -lmsvcrt -lkernel32 -luser32 -ladvapi32 -lws2_32 -lbcrypt -lntdll -luserenv
