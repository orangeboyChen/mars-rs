{
  "name": "marsrs-react-native",
  "version": "0.1.0-alpha.3",
  "description": "React Native module for mars-rs, a Rust implementation of Tencent/mars: the whole port, xlog today.",
  "license": "MIT",
  "homepage": "https://github.com/orangeboyChen/mars-rs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orangeboyChen/mars-rs.git",
    "directory": "platforms/react-native/marsrs"
  },
  "bugs": {
    "url": "https://github.com/orangeboyChen/mars-rs/issues"
  },
  "keywords": [
    "mars",
    "xlog",
    "logging",
    "react-native"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "*.podspec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "codegenConfig": {
    "name": "NativeXlogSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.github.orangeboychen.marsrs.reactnative"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  }
}
