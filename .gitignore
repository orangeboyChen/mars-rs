/target

# the Android project: what the release workflow unpacks and what Gradle writes
android/*/libs/
android/.gradle/
android/build/
android/*/build/
android/local.properties
/dist

# the Kotlin Multiplatform project: the native libraries the release unpacks
# into it (kmp/native/<kotlin-target>/libmars_ffi.a, kmp/native/android/<abi>/)
# and what Gradle writes
kmp/native/
kmp/.gradle/
kmp/build/
kmp/*/build/
kmp/local.properties

# the VitePress site: what `npm ci` installs and what `vitepress build` and its
# dev server write. `docs/package-lock.json` is checked in, so the install is
# reproducible and this is the only part of the site that is not.
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
