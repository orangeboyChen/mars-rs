/target

# the coverage report: what `cargo llvm-cov --lcov` writes for
# .github/workflows/rust.yml to upload, and what it leaves behind when it is
# run by hand
/lcov.info

# platforms/android: what the release workflow unpacks and what Gradle writes
platforms/android/*/libs/
platforms/android/.gradle/
platforms/android/build/
platforms/android/*/build/
platforms/android/local.properties
/dist

# platforms/harmonyos: where scripts/fetch_deveco_cli.sh unpacks the DevEco
# Command Line Tools — a cache of someone else's archive, and not a source of
# this repository
/.deveco-cli

# platforms/kmp: the native libraries the release unpacks into it
# (platforms/kmp/native/<kotlin-target>/libmars_ffi.a,
# platforms/kmp/native/android/<abi>/) and what Gradle writes
platforms/kmp/native/
platforms/kmp/.gradle/
platforms/kmp/build/
platforms/kmp/*/build/
platforms/kmp/local.properties

# the VitePress site: what `npm ci` installs and what `vitepress build` and its
# dev server write. `docs/package-lock.json` is checked in, so the install is
# reproducible and this is the only part of the site that is not.
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# the Flutter and React Native packages: what scripts/package_flutter.sh and
# scripts/package_react_native.sh drop into a package before it is packed — the
# Apple framework of the release, the C ABI's own header, and the licence of the
# port. None of the three is a source of this repository.
platforms/flutter/*/ios/Frameworks/
platforms/flutter/*/ios/include/
platforms/flutter/*/LICENSE
platforms/react-native/*/ios/Frameworks/
platforms/react-native/*/ios/include/
platforms/react-native/*/LICENSE

# demo: what a demo run leaves behind, and what a demo's own toolchain writes.
# None of it is a source — every directory below is one a command recreates.
demo/rust/target/
# A lock file of a demo says nothing an app does not work out again: the
# dependencies are the crates of this repository, taken by path, so theirs is
# the lock that matters and this one only ever follows it.
demo/rust/Cargo.lock
demo/rust/log/
demo/c/demo
demo/c/log/
demo/android/.gradle/
demo/android/build/
demo/android/*/build/
demo/android/local.properties
demo/kmp/.gradle/
demo/kmp/build/
demo/kmp/log/
# what DevEco and ohpm write, and the HAR of the port `demo/harmonyos/README.md`
# says to download into `libs/`
demo/harmonyos/.hvigor/
demo/harmonyos/build/
demo/harmonyos/oh_modules/
demo/harmonyos/node_modules/
demo/harmonyos/*/oh_modules/
demo/harmonyos/*/build/
demo/harmonyos/*/.preview/
demo/harmonyos/libs/
# what `flutter create` and `flutter pub get` write in a demo's own directory,
# once `demo/flutter/README.md` says to run them there
demo/flutter/.dart_tool/
demo/flutter/build/
demo/flutter/.idea/
demo/flutter/.flutter-plugins
demo/flutter/.flutter-plugins-dependencies
demo/flutter/.packages
demo/flutter/pubspec.lock
demo/react-native/node_modules/
